{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kb-inbox.local/contracts/content_document_v3.schema.json",
  "title": "ContentDocument v3 (content.json)",
  "description": "docs/24 §1 顶层字段与 §2 引用表的机检镜像。枚举与上限以 docs/24 为准，与 apps/server/kbserver/domain/content_v3.py 的常量由契约测试保持一致；跨 sections 的块总数与序列化体积无法用 Schema 表达，由 x- 注解声明并由 Python 校验器执行。",
  "type": "object",
  "x-max-total-blocks": 200,
  "x-max-serialized-utf8-bytes": 524288,
  "required": [
    "format_version",
    "document_id",
    "kind",
    "revision",
    "created_at",
    "title",
    "summary",
    "sections",
    "references",
    "limitations",
    "completeness",
    "provenance"
  ],
  "additionalProperties": false,
  "properties": {
    "format_version": {
      "type": "string",
      "const": "3.0"
    },
    "document_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    },
    "kind": {
      "type": "string",
      "enum": ["digest", "knowledge", "synthesis"]
    },
    "revision": {
      "type": "integer",
      "minimum": 1
    },
    "created_at": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]{1,6})?(Z|[+-][0-9]{2}:[0-9]{2})$"
    },
    "title": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    },
    "summary": {
      "type": "string",
      "maxLength": 500
    },
    "sections": {
      "type": "array",
      "minItems": 1,
      "maxItems": 40,
      "items": { "$ref": "#/$defs/section" }
    },
    "references": {
      "type": "object",
      "maxProperties": 60,
      "propertyNames": { "pattern": "^e[0-9]{1,4}$" },
      "additionalProperties": { "$ref": "#/$defs/ref" }
    },
    "limitations": {
      "type": "array",
      "maxItems": 10,
      "items": { "type": "string", "minLength": 1, "maxLength": 1000 }
    },
    "completeness": { "$ref": "#/$defs/completeness" },
    "provenance": { "$ref": "#/$defs/provenance" }
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "segmentId": {
      "type": "string",
      "pattern": "^s[0-9]{4,}$"
    },
    "section": {
      "type": "object",
      "required": ["heading", "blocks"],
      "additionalProperties": false,
      "properties": {
        "heading": {
          "type": "string",
          "maxLength": 200
        },
        "blocks": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/block" }
        }
      }
    },
    "block": {
      "type": "object",
      "required": ["kind", "text", "refs"],
      "additionalProperties": false,
      "properties": {
        "kind": {
          "type": "string",
          "enum": ["claim", "quote", "suggestion", "text"]
        },
        "text": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2000,
          "not": { "pattern": "(\\[\\[|\\^c[0-9]{4})" }
        },
        "refs": {
          "type": "array",
          "uniqueItems": true,
          "maxItems": 60,
          "items": { "type": "string", "pattern": "^e[0-9]{1,4}$" }
        }
      }
    },
    "locator": {
      "type": "object",
      "description": "只用于界面显示自然位置；禁止把 R1/e1/s0001 显示给用户。",
      "required": ["kind"],
      "additionalProperties": false,
      "properties": {
        "kind": { "type": "string", "enum": ["time", "paragraph", "line"] },
        "start_ms": { "type": "integer", "minimum": 0 },
        "end_ms": { "type": "integer", "minimum": 0 },
        "paragraph_id": { "type": "string", "minLength": 1, "maxLength": 100 },
        "line_no": { "type": "integer", "minimum": 1 }
      },
      "oneOf": [
        { "properties": { "kind": { "const": "time" } }, "required": ["kind", "start_ms", "end_ms"] },
        { "properties": { "kind": { "const": "paragraph" } }, "required": ["kind", "paragraph_id"] },
        { "properties": { "kind": { "const": "line" } }, "required": ["kind", "line_no"] }
      ]
    },
    "ref": {
      "type": "object",
      "description": "docs/24 §2：单一引用指向一份固定来源中的连续原文范围；source_text_hash 对 \"\\n\".join(片段原文) 的 UTF-8 字节计算。",
      "required": ["item_id", "source_revision", "segment_ids", "source_text_hash"],
      "additionalProperties": false,
      "properties": {
        "item_id": { "type": "string", "minLength": 1, "maxLength": 200 },
        "source_revision": { "type": "integer", "minimum": 1 },
        "segment_ids": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/segmentId" }
        },
        "source_text_hash": { "$ref": "#/$defs/sha256" },
        "locator": { "$ref": "#/$defs/locator" }
      }
    },
    "missingStage": {
      "type": "string",
      "pattern": "^(summary|quote_verification|evidence_resolution|legacy_evidence_unresolved|chunk:[0-9]{1,4})$"
    },
    "gap": {
      "type": "object",
      "description": "code 是机器码，message 是给用户看的中文文案；界面禁止渲染枚举。block 为 1 基 [章节序号, 块序号]，[n, 0] 表示整节。",
      "required": ["code", "message", "refs", "segment_ids", "block"],
      "additionalProperties": false,
      "properties": {
        "code": {
          "type": "string",
          "enum": [
            "json_unparsable",
            "missing_subject",
            "truncated",
            "bad_ref",
            "quote_not_verbatim",
            "empty_document",
            "ref_table_mismatch",
            "limit_exceeded",
            "chunk_failed",
            "all_refs_invalid",
            "legacy_evidence_unresolved"
          ]
        },
        "message": { "type": "string", "minLength": 1, "maxLength": 1000 },
        "refs": { "type": "array", "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
        "segment_ids": { "type": "array", "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
        "block": {
          "type": "array",
          "minItems": 0,
          "maxItems": 2,
          "items": { "type": "integer", "minimum": 0 }
        }
      }
    },
    "completeness": {
      "type": "object",
      "required": ["state", "missing_stages", "gaps", "dropped_blocks", "repair_calls"],
      "additionalProperties": false,
      "properties": {
        "state": {
          "type": "string",
          "enum": ["complete", "partial", "failed"]
        },
        "missing_stages": {
          "type": "array",
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/missingStage" }
        },
        "gaps": {
          "type": "array",
          "items": { "$ref": "#/$defs/gap" }
        },
        "dropped_blocks": { "type": "integer", "minimum": 0 },
        "repair_calls": { "type": "integer", "minimum": 0 }
      }
    },
    "provenance": {
      "type": "object",
      "required": ["recipe_version", "task", "input_documents", "source_revisions"],
      "additionalProperties": false,
      "properties": {
        "recipe_version": { "type": "string", "minLength": 1, "maxLength": 100 },
        "task": {
          "type": "string",
          "enum": ["digest", "knowledge_fusion", "share_synthesis"]
        },
        "input_documents": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["document_id", "kind", "revision"],
            "additionalProperties": false,
            "properties": {
              "document_id": { "type": "string", "minLength": 1, "maxLength": 200 },
              "kind": { "type": "string", "enum": ["digest", "knowledge", "synthesis"] },
              "revision": { "type": "integer", "minimum": 1 }
            }
          }
        },
        "source_revisions": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["item_id", "source_revision"],
            "additionalProperties": false,
            "properties": {
              "item_id": { "type": "string", "minLength": 1, "maxLength": 200 },
              "source_revision": { "type": "integer", "minimum": 1 }
            }
          }
        }
      }
    }
  }
}
