# Knowledge Inbox Server 配置示例。只列变量名与非秘密默认值；真实密钥走 secret 文件。

# 基础
PUBLIC_BASE_URL=http://localhost:8000
DATABASE_URL=sqlite:////data/db/app.db
OBJECTS_DIR=/data/objects
TMP_DIR=/data/tmp
DELETIONS_DIR=/data/deletions

# 主密钥（32 字节，由运维生成；通过只读 secret 文件提供，不进镜像/数据库）
MASTER_KEY_FILE=/run/secrets/master_key
MASTER_KEY_VERSION=1
SESSION_SECRET_FILE=/run/secrets/session_secret

# 容量限制
MAX_SINGLE_FILE_BYTES=104857600
MAX_IMAGE_BYTES=20971520
MAX_JSON_BODY_BYTES=1048576
MAX_ATTACHMENTS_PER_CAPTURE=10
MAX_CAPTURE_TOTAL_BYTES=104857600
HTML_DOWNLOAD_LIMIT=5242880
SUBTITLE_DOWNLOAD_LIMIT=10485760
# 单条正文图片总量（张数上限之外的字节闸门；2 核 2GB 机器的内存峰值兜底）
IMAGES_TOTAL_BYTES=41943040

# 保留与清理
UNREFERENCED_UPLOAD_TTL_HOURS=24
UNACKED_BUNDLE_RETENTION_DAYS=30
ACKED_BUNDLE_RETENTION_DAYS=7
IDEMPOTENCY_KEY_TTL_DAYS=90
EVENT_RETENTION_DAYS=90

# 身份
TOKEN_TTL_DAYS=90

# 中心认证（统一登录由 auth.jerrythealpaca.cn 的 Ledger 提供，docs/05 §4.1）
# AUTH_COOKIE_NAME 必须与 Ledger 生产 SESSION_COOKIE_NAME 一致；
# AUTH_COOKIE_DOMAIN 与 Ledger 的 COOKIE_DOMAIN 一致（无前导点）；
# KB 的 Origin 需加入 Ledger 的 ALLOWED_ORIGINS，返回地址加入 ALLOWED_RETURN_TO。
AUTH_SESSION_URL=https://auth.jerrythealpaca.cn/api/auth/session
AUTH_LOGIN_URL=https://auth.jerrythealpaca.cn/login
AUTH_REGISTER_URL=https://auth.jerrythealpaca.cn/register
AUTH_LOGOUT_URL=https://auth.jerrythealpaca.cn/api/auth/logout
AUTH_COOKIE_NAME=__Secure-jerry_session
AUTH_COOKIE_DOMAIN=jerrythealpaca.cn
AUTH_TIMEOUT_SECONDS=5
AUTH_FORWARD_ORIGIN=https://kb.jerrythealpaca.cn

# 插件设备授权（docs/05 §4.5）
DEVICE_AUTH_TTL_SECONDS=300
DEVICE_AUTH_POLL_INTERVAL_SECONDS=2

# Worker
JOB_LEASE_SECONDS=120
JOB_MAX_LIFETIME_DAYS=7
WORKER_POLL_SECONDS=2

# 模型供应商（docs/02 §9.3）：逗号分隔的 HTTPS host 白名单；"*" 放行任意 HTTPS（自部署自担风险）
PROVIDER_ALLOWED_ORIGINS=api.openai.com,api.deepseek.com,api.moonshot.cn,open.bigmodel.cn,dashscope.aliyuncs.com,api.siliconflow.cn,openrouter.ai,api.mistral.ai,api.groq.com,api.together.xyz,api.anthropic.com,api.x.ai

# 通用 AI 整合与 HTML 分享（docs/20 §14.1）：工程初始值，用于首轮实现与压测，
# 不是已验证容量。默认关闭，开发验收后启用。
SHARE_ENABLED=false
# 独立分享站点必须是与账号站不同可注册域名（账号 Cookie 带主域，换子域不等于隔离）；
# 为空时「生成分享链接」如实显示配置未完成，私有预览与下载不受影响
SHARE_PUBLIC_BASE_URL=
SHARE_SPOOL_DIR=./data/share-spool
SHARE_RUNTIME_MANIFEST=apps/share-renderer/runtime-manifest.json
SHARE_MAX_ITEMS=20
SHARE_MAX_INSTRUCTIONS_CHARS=4000
SHARE_MAX_QUESTIONS_PER_ROUND=3
SHARE_CLARIFICATION_OUTPUT_TOKENS=1200
SHARE_SYNTHESIS_OUTPUT_TOKENS=8000
SHARE_PAGE_OUTPUT_TOKENS=16000
SHARE_MAX_WAITING_DRAFTS_PER_USER=20
SHARE_CONTEXT_COMPACT_RATIO=0.8
SHARE_MAX_SOURCE_CHARS=200000
SHARE_MAX_INPUT_BYTES=52428800
SHARE_MAX_HTML_BYTES=10485760
SHARE_MAX_ACTIVE_PER_USER=1
SHARE_MAX_QUEUED_PER_USER=5
SHARE_RENDER_CONCURRENCY=1
SHARE_MAX_REPAIRS=2
SHARE_RENDER_TIMEOUT_SECONDS=60
SHARE_MAX_RENDER_RETRIES=1
SHARE_PREVIEW_TTL_SECONDS=300
SHARE_MAX_STORAGE_BYTES_PER_USER=524288000
SHARE_REVISION_RETENTION_DAYS=30
SHARE_RUN_DIAGNOSTIC_RETENTION_DAYS=7
SHARE_SPOOL_TTL_HOURS=24
