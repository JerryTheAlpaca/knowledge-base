# kb（信息沉淀知识库 Web 收件箱）的 Caddy 站点片段。
# 宿主机 /etc/caddy/Caddyfile 是多站点共享的（atlas/ledger/auth），
# 本文件只是本仓库拥有的片段：部署时把下面的站点块追加到宿主机
# Caddyfile（不要覆盖），然后 `sudo systemctl reload caddy`。
# 证书由 Caddy 自动申请续期（DNS 已有 A 记录 -> 122.51.211.231）。

kb.jerrythealpaca.cn {
	encode zstd gzip
	# 音频上传走串行分块（docs/13 §6.2），单块 16MiB：Caddy 默认不限制请求体大小，
	# 也没有请求读超时，因此无需额外放宽；不要在反代层设置低于单块的 max_size，
	# 也不要把空闲超时设得比一次块上传更短（应用侧只做单块与少量头部余量）。
	reverse_proxy 127.0.0.1:8000
}
