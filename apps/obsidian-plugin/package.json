{
  "name": "golden-rose-inbox",
  "version": "0.3.0",
  "description": "自托管知识收件箱：把网页、文章和视频增量同步进 Vault，写入前校验、编辑时保护。",
  "main": "main.js",
  "scripts": {
    "typecheck": "tsc --noEmit --skipLibCheck",
    "dev": "node esbuild.config.mjs",
    "build": "tsc --noEmit --skipLibCheck && node esbuild.config.mjs production"
  },
  "keywords": [
    "obsidian",
    "golden-rose-inbox"
  ],
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^22.15.0",
    "builtin-modules": "^4.0.0",
    "esbuild": "^0.25.0",
    "obsidian": "^1.8.7",
    "tslib": "^2.8.1",
    "typescript": "^5.8.0"
  }
}
